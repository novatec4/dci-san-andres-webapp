# =============================================================================
# NGINX_PROD.CONF.EXAMPLE - Plantilla para el Contenedor Nginx Global de Producción
# Dominio: info-dci.bidata.dev
# =============================================================================

server {
    listen 80;
    server_name info-dci.bidata.dev;

    # Ruta absoluta donde se encuentra la carpeta 'dist' del proyecto DCI
    root /var/www/dci-app;
    index index.html;

    # Compresión Gzip para optimizar ancho de banda rural
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json image/svg+xml;

    # Cabeceras de Seguridad y Protección de Datos LOPDP
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Cache inmutable para bundles Vite con hash
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Datos GIS y Padrón
    location ~* \.geojson$ {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*";
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Healthcheck
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Fallback de SPA
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    error_page 500 502 503 504 /50x.html;
}
